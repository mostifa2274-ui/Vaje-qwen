# Cloudflare Workers static-asset headers. The content policy itself is a
# <meta> tag in index.html so the browser tests exercise it; frame-ancestors
# only works as a header, so it lives here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# Vite names every file here by its content hash.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
