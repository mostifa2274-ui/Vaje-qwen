{
  "name": "vajeh",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node bootstrap/restore.mjs",
    "prepare": "node bootstrap/restore.mjs",
    "prebuild": "node bootstrap/restore.mjs",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "node bootstrap/restore.mjs && eslint .",
    "test": "node bootstrap/restore.mjs && vitest run",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "deploy": "npm run cloudflare:build && npx wrangler@4.135.0 deploy",
    "cloudflare:build": "node bootstrap/restore.mjs && npm install --ignore-scripts --legacy-peer-deps --no-audit --no-fund && npm run build",
    "cloudflare:deploy": "npm run cloudflare:build && npx wrangler@4.135.0 deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
