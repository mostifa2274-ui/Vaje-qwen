{
  "name": "ghesse",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp-release.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run validate:release-config && npm run validate:data && npm run validate:editorial && npm run validate:introductions && npm run validate:mastery && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "validate:release-config": "node scripts/validate-release-config.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:editorial": "node scripts/validate-editorial.mjs",
    "validate:introductions": "node scripts/validate-introductions.mjs",
    "validate:mastery": "node scripts/validate-mastery.mjs",
    "prepare": "npm run build",
    "cloudflare:build": "npm run check",
    "deploy": "npm ci --include=dev --ignore-scripts --no-audit --no-fund && npm run cloudflare:build && npx wrangler@4.135.0 deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.1"
}
